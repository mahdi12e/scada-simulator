{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scada-simulator",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "scada-simulator-db",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
  }]
}
